{
  "name": "@popark05/qa-platform",
  "version": "0.4.0",
  "private": false,
  "description": "QA test management, human review and cross-platform execution orchestration.",
  "type": "module",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server/index.js",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/infrastructure/migrate.ts"
  },
  "dependencies": {
    "fastify": "^5.2.1",
    "mobilewright": "0.0.70",
    "pg": "^8.16.3",
    "playwright": "^1.55.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/pg": "^8.15.5",
    "pg-mem": "^3.0.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
